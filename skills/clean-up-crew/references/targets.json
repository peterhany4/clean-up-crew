    {
      "id": "chrome-cache",
      "name": "Chrome caches",
      "tier": 1,
      "type": "profile-caches",
      "profileRoot": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
      "profilePattern": "^(Default|Profile \\d+)$",
      "cacheDirs": [
        "Cache",
        "Code Cache",
        "Service Worker",
        "GPUCache",
        "DawnCache",
        "DawnGraphiteCache",
        "DawnWebGPUCache",
        "GrShaderCache",
        "ShaderCache",
        "Media Cache"
      ],
      "extraPaths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\component_crx_cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GrShaderCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\ShaderCache"
      ],
      "exclude": [],
      "processes": [
        "chrome"
      ],
      "requiresAdmin": false,
      "regenerates": "Chrome rebuilds caches; logins and bookmarks are kept",
      "risk": "sites load slower once"
    },
